<Window x:Class="LightBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightBrowser" Width="1280" Height="800" MinWidth="720" MinHeight="480"
        Background="#1E1F24"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profiles -->
        <DockPanel Grid.Column="0" Background="#25262B">
            <TextBlock DockPanel.Dock="Top" Text="PROFILES" Foreground="#8A8D96" FontSize="11"
                       FontWeight="SemiBold" Margin="14,14,0,6"/>
            <Grid DockPanel.Dock="Top" Margin="8,0,8,6">
                <TextBox x:Name="SearchBox" Padding="8,5" Background="#1E1F24" Foreground="#E6E6E6"
                         BorderBrush="#3A3B42" CaretBrush="#E6E6E6" SelectionBrush="#4F8EF7"
                         TextChanged="Search_TextChanged" KeyDown="SearchBox_KeyDown"/>
                <TextBlock x:Name="SearchHint" Text="Search (Ctrl+K)" Foreground="#6B6E78"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Button x:Name="TrashBtn" DockPanel.Dock="Bottom" Content="Trash" Style="{StaticResource Flat}"
                    Foreground="#8A8D96" Margin="8,0,8,8" Click="Trash_Click"/>
            <Button DockPanel.Dock="Bottom" Content="+ New profile" Style="{StaticResource Flat}"
                    Background="#33FFFFFF" Margin="8,8,8,4" Padding="8,8" Click="AddProfile_Click"/>
            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Item}"
                     SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#8A8D96" FontSize="11"
                                           FontWeight="SemiBold" Margin="12,10,0,2"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Background="Transparent"
                                    ToolTip="{Binding NotesTip}">
                            <StackPanel.ContextMenu>
                                <ContextMenu Opened="ProfileMenu_Opened">
                                    <MenuItem Tag="normal" Header="Open home pages" Click="OpenHome_Click"/>
                                    <MenuItem Tag="normal" Header="Edit..." Click="EditProfile_Click"/>
                                    <MenuItem Tag="open" Header="Close profile (frees memory)" Click="CloseProfile_Click"/>
                                    <MenuItem Tag="normal" Header="Move to Trash" Click="MoveToTrash_Click"/>
                                    <MenuItem Tag="trash" Header="Restore" Click="Restore_Click"/>
                                    <MenuItem Tag="trash" Header="Delete forever (wipes its data)" Click="DeleteForever_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="120"/>
                            <Ellipse Width="7" Height="7" Fill="#3DBE7A" Margin="8,0,0,0" ToolTip="Open"
                                     Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Colour bar, tabs, toolbar, page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shows which client profile you are in, in that profile's colour -->
            <Border x:Name="ProfileBar" Grid.Row="0" Background="Transparent"/>

            <DockPanel Grid.Row="1" Background="#2B2C32">
                <Button DockPanel.Dock="Right" Content="+" Style="{StaticResource Flat}" Width="34"
                        Margin="4" ToolTip="New tab (Ctrl+T)" Click="NewTab_Click"/>
                <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource Item}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="TabList_SelectionChanged"
                         PreviewMouseDown="TabList_PreviewMouseDown">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}" Background="Transparent">
                                <TextBlock Text="{Binding Title}" MaxWidth="150"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="x" Style="{StaticResource Flat}" Margin="8,0,0,0"
                                        Padding="5,0" FontSize="11" ToolTip="Close tab (Ctrl+W)"
                                        Click="CloseTab_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Row="2" Background="#25262B">
                <DockPanel>
                    <Button x:Name="BackBtn" DockPanel.Dock="Left" Content="&lt;" Width="34" Margin="6,6,0,6"
                            Style="{StaticResource Flat}" ToolTip="Back" Click="Back_Click"/>
                    <Button x:Name="ForwardBtn" DockPanel.Dock="Left" Content="&gt;" Width="34" Margin="2,6,0,6"
                            Style="{StaticResource Flat}" ToolTip="Forward" Click="Forward_Click"/>
                    <Button DockPanel.Dock="Left" Content="R" Width="34" Margin="2,6,6,6"
                            Style="{StaticResource Flat}" ToolTip="Reload" Click="Reload_Click"/>
                    <TextBox x:Name="Address" Margin="0,6,8,6" Padding="8,0" VerticalContentAlignment="Center"
                             Background="#1E1F24" Foreground="#E6E6E6" BorderBrush="#3A3B42"
                             CaretBrush="#E6E6E6" SelectionBrush="#4F8EF7" KeyDown="Address_KeyDown"/>
                </DockPanel>
                <ProgressBar x:Name="Loading" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom"
                             Foreground="#4F8EF7" Background="Transparent" BorderThickness="0"
                             Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="WebHost"/>
                <TextBlock x:Name="EmptyState" Text="Create a profile on the left to begin"
                           Foreground="#8A8D96" FontSize="16" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
