<Window x:Class="LightBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightBrowser" Icon="assets/icon.ico" Width="1280" Height="800" MinWidth="760" MinHeight="480"
        Background="{StaticResource WindowBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profiles -->
        <DockPanel x:Name="Sidebar" Grid.Column="0" Background="{StaticResource PanelBrush}">
            <Grid DockPanel.Dock="Top" Margin="16,14,12,10">
                <TextBlock Text="Profiles" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="&#xE710;" Style="{StaticResource PrimaryBtn}" HorizontalAlignment="Right"
                        FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12" Padding="0" Width="30" Height="30"
                        ToolTip="New profile" AutomationProperties.Name="New profile" Click="AddProfile_Click"/>
            </Grid>
            <Border DockPanel.Dock="Top" Margin="12,0,12,6" Background="{StaticResource FieldBrush}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="9">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"
                               Foreground="{StaticResource FaintBrush}" Margin="11,0,0,0" VerticalAlignment="Center"
                               HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Padding="31,7,8,7" Background="Transparent" BorderThickness="0"
                             Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                             SelectionBrush="{StaticResource PrimaryBrush}"
                             TextChanged="Search_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchHint" Text="Search profiles (Ctrl+K)" Foreground="{StaticResource FaintBrush}"
                               Margin="32,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <!-- Footer: one compact block instead of a tall stack of buttons -->
            <Button x:Name="UpdateBtn" DockPanel.Dock="Bottom" Style="{StaticResource Flat}" HorizontalAlignment="Left"
                    Margin="10,0,12,8" Padding="6,3" FontSize="10.5" Foreground="{StaticResource FaintBrush}"
                    Click="Update_Click" AutomationProperties.Name="Update"/>
            <TextBlock x:Name="StatsText" DockPanel.Dock="Bottom" Foreground="{StaticResource FaintBrush}" FontSize="10.5"
                       TextTrimming="CharacterEllipsis" Margin="16,0,12,12"
                       ToolTip="Tabs loaded now / limit for the current mode, and this app's memory including its browser processes"/>
            <Border DockPanel.Dock="Bottom" Margin="12,0,12,8" Background="{StaticResource FieldBrush}" CornerRadius="9" Padding="2">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ModeLowBtn" Grid.Column="0" Content="Low RAM" Tag="LowMemory" FontSize="11.5"
                            Style="{StaticResource Flat}" Padding="4,5" Click="Mode_Click"
                            ToolTip="Low RAM: 2 tabs loaded at once, unused tabs unloaded after 3 minutes. Best for many clients on a small PC."/>
                    <Button x:Name="ModeBalancedBtn" Grid.Column="1" Content="Balanced" Tag="Balanced" FontSize="11.5"
                            Style="{StaticResource Flat}" Padding="4,5" Click="Mode_Click"
                            ToolTip="Balanced: 5 tabs loaded at once, unused tabs unloaded after 10 minutes."/>
                    <Button x:Name="ModePerformanceBtn" Grid.Column="2" Content="Fast" Tag="Performance" FontSize="11.5"
                            Style="{StaticResource Flat}" Padding="4,5" Click="Mode_Click"
                            ToolTip="Fast: 15 tabs loaded at once, unused tabs kept for an hour, hidden tabs not trimmed. Fastest switching, uses the most RAM."/>
                </Grid>
            </Border>
            <Grid DockPanel.Dock="Bottom" Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Launch site..." Style="{StaticResource Flat}" Background="#1FFFFFFF"
                        FontSize="12" Padding="6,7" Click="Launch_Click"
                        ToolTip="Open one website in several profiles at once, or close several profiles"/>
                <Button x:Name="TrashBtn" Grid.Column="2" Content="Trash" Style="{StaticResource Flat}" Background="#1FFFFFFF"
                        Foreground="{StaticResource DimBrush}" FontSize="12" Padding="6,7" Click="Trash_Click"/>
            </Grid>

            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Item}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource FaintBrush}" FontSize="11"
                                           FontWeight="SemiBold" Margin="16,12,0,3"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding Tip}"
                              MouseLeftButtonDown="ProfileRow_MouseDown">
                            <Grid.ContextMenu>
                                <ContextMenu Opened="ProfileMenu_Opened">
                                    <MenuItem Tag="normal" Header="Open home pages" Click="OpenHome_Click"/>
                                    <MenuItem Tag="normal" Header="Rename (F2)" Click="Rename_Click"/>
                                    <MenuItem Tag="normal" Header="Edit..." Click="EditProfile_Click"/>
                                    <MenuItem Tag="normal" Header="History..." Click="History_Click"/>
                                    <MenuItem Tag="normal" Header="Saved passwords..." Click="Passwords_Click"/>
                                    <MenuItem Tag="normal" Header="Duplicate (without logins)" Click="Duplicate_Click"/>
                                    <MenuItem Tag="open" Header="Close profile (frees memory)" Click="CloseProfile_Click"/>
                                    <MenuItem Tag="open" Header="Restart profile" Click="Restart_Click"/>
                                    <MenuItem Tag="normal" Header="Clear website data..." Click="ClearData_Click"/>
                                    <MenuItem Tag="normal" Header="Move to Trash" Click="MoveToTrash_Click"/>
                                    <MenuItem Tag="trash" Header="Restore" Click="Restore_Click"/>
                                    <MenuItem Tag="trash" Header="Delete forever (wipes its data)" Click="DeleteForever_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="28" Height="28" Margin="2,0,10,0">
                                <Ellipse Fill="{Binding Brush}"/>
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#3DBE7A" Margin="6,0,6,0" ToolTip="Open"
                                     Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel x:Name="HoverButtons" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="RenameBtn" Content="&#xE70F;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Rename" AutomationProperties.Name="Rename" Click="Rename_Click"/>
                                <Button x:Name="TrashItemBtn" Content="&#xE74D;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Move to Trash" AutomationProperties.Name="Move to Trash" Click="MoveToTrash_Click"/>
                                <Button x:Name="RestoreBtn" Content="&#xE7A7;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Restore" AutomationProperties.Name="Restore" Visibility="Collapsed"
                                        Click="Restore_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverButtons" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter TargetName="RenameBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TrashItemBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="RestoreBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Colour bar, tabs, toolbar, page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shows which client profile you are in, in that profile's colour -->
            <Border x:Name="ProfileBar" Grid.Row="0" Background="Transparent"/>

            <DockPanel Grid.Row="1" Background="{StaticResource BarBrush}">
                <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource IconBtn}"
                        Margin="4,4,6,4" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab" Click="NewTab_Click"/>
                <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="TabList_SelectionChanged"
                         PreviewMouseDown="TabList_PreviewMouseDown"
                         PreviewMouseWheel="TabList_PreviewMouseWheel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="TabRow" ToolTip="{Binding Title}" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="16" Height="16" Margin="0,0,8,0">
                                    <TextBlock x:Name="Glyph" Text="&#xE774;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                               FontSize="12" Foreground="{StaticResource FaintBrush}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Image Source="{Binding Favicon}" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <Button x:Name="CloseBtn" Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconBtn}"
                                        Width="22" Height="22" FontSize="9" Opacity="0" IsHitTestVisible="False"
                                        ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab" Click="CloseTab_Click"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Favicon}" Value="{x:Null}">
                                    <Setter TargetName="Glyph" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger SourceName="TabRow" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="CloseBtn" Property="IsHitTestVisible" Value="True"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="CloseBtn" Property="Opacity" Value="1"/>
                                    <Setter TargetName="CloseBtn" Property="IsHitTestVisible" Value="True"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid x:Name="Toolbar" Grid.Row="2" Background="{StaticResource PanelBrush}">
                <DockPanel Margin="8,0,8,0">
                    <Button DockPanel.Dock="Left" Content="&#xE700;" Style="{StaticResource IconBtn}"
                            Margin="0,0,6,0" ToolTip="Show or hide the profile panel (Ctrl+B)"
                            AutomationProperties.Name="Toggle profile panel" Click="SidebarToggle_Click"/>
                    <Button x:Name="ProfileChip" DockPanel.Dock="Left" Style="{StaticResource Flat}" Visibility="Collapsed"
                            Margin="0,0,8,0" Height="30" Padding="6,0" Click="ProfileChip_Click"
                            ToolTip="Switch profile (Ctrl+K)" AutomationProperties.Name="Switch profile">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="22" Height="22" Margin="0,0,7,0">
                                <Ellipse x:Name="ChipDot" Fill="#4F8EF7"/>
                                <TextBlock x:Name="ChipInitial" Text="+" Foreground="White" FontWeight="SemiBold"
                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock x:Name="ChipName" Text="Choose profile" MaxWidth="150" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="9"
                                       Foreground="{StaticResource DimBrush}" Margin="7,1,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BackBtn" DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource IconBtn}"
                            Margin="0,0,2,0" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click"/>
                    <Button x:Name="ForwardBtn" DockPanel.Dock="Left" Content="&#xE72A;" Style="{StaticResource IconBtn}"
                            Margin="0,0,2,0" ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click"/>
                    <Button DockPanel.Dock="Left" Content="&#xE72C;" Style="{StaticResource IconBtn}"
                            Margin="0,0,8,0" ToolTip="Reload" AutomationProperties.Name="Reload" Click="Reload_Click"/>
                    <Button DockPanel.Dock="Right" Content="&#xE81C;" Style="{StaticResource IconBtn}"
                            Margin="4,0,0,0" ToolTip="History (Ctrl+H)" AutomationProperties.Name="History" Click="HistoryButton_Click"/>
                    <Button x:Name="SearchBtn" DockPanel.Dock="Right" Content="&#xE721;" Style="{StaticResource IconBtn}"
                            Margin="4,0,0,0" AutomationProperties.Name="Search engine" Click="SearchEngine_Click"/>
                    <Button x:Name="BlockBtn" DockPanel.Dock="Right" Content="Blocking" Style="{StaticResource Flat}" FontSize="12"
                            Margin="4,0,0,0" Height="30" Click="BlockToggle_Click" AutomationProperties.Name="Blocking"/>
                    <Button DockPanel.Dock="Right" Content="Passwords" Style="{StaticResource Flat}" FontSize="12"
                            Foreground="{StaticResource DimBrush}" Margin="4,0,0,0" Height="30"
                            ToolTip="This profile's saved passwords" Click="PasswordsButton_Click"/>
                    <Border BorderThickness="1" CornerRadius="16" Height="33" Background="{StaticResource FieldBrush}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecurityIcon" Grid.Column="0" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource FaintBrush}" Text="&#xE721;" IsHitTestVisible="True"/>
                            <TextBox x:Name="Address" Grid.Column="1" Padding="0,0,14,0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                                     CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource PrimaryBrush}"
                                     KeyDown="Address_KeyDown" PreviewKeyDown="Address_PreviewKeyDown"
                                     TextChanged="Address_TextChanged" LostKeyboardFocus="Address_LostFocus"/>
                        </Grid>
                    </Border>
                </DockPanel>
                <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=Address}"
                       Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                    <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="2" MinWidth="{Binding ActualWidth, ElementName=Address}">
                        <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Item}"
                                 PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown"/>
                    </Border>
                </Popup>
                <!-- Quick profile switcher, used when the left panel is hidden. A popup, because nothing
                     inside the window can draw over the web page. -->
                <Popup x:Name="SwitcherPopup" PlacementTarget="{Binding ElementName=ProfileChip}"
                       Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
                    <Border Background="{StaticResource BarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                            CornerRadius="12" Padding="6" Width="320" Margin="0,4,10,10">
                        <DockPanel>
                            <TextBox x:Name="SwitcherSearch" DockPanel.Dock="Top" Padding="9,8" Margin="0,0,0,6"
                                     Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                                     Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}"
                                     SelectionBrush="{StaticResource PrimaryBrush}"
                                     TextChanged="Switcher_TextChanged" KeyDown="Switcher_KeyDown"/>
                            <ListBox x:Name="SwitcherList" MaxHeight="360" Background="Transparent" BorderThickness="0"
                                     ItemContainerStyle="{StaticResource Item}"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     PreviewMouseLeftButtonDown="SwitcherList_PreviewMouseLeftButtonDown">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="26" Height="26" Margin="0,0,10,0">
                                                <Ellipse Fill="{Binding Brush}"/>
                                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                                           FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Group}" Foreground="{StaticResource DimBrush}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Popup>
                <ProgressBar x:Name="Loading" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="WebHost"/>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                    <Grid Width="84" Height="84" HorizontalAlignment="Center">
                        <Ellipse Fill="#1F4F8EF7"/>
                        <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="34"
                                   Foreground="{StaticResource PrimaryBrush}" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="One browser, every client" Foreground="{StaticResource TextBrush}" FontSize="22"
                               FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,0"/>
                    <TextBlock x:Name="EmptyState" Text="Create a profile to begin"
                               Foreground="{StaticResource DimBrush}" FontSize="14" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,8,0,0" IsHitTestVisible="False"/>
                    <Button x:Name="EmptyNewBtn" Content="New profile" Style="{StaticResource PrimaryBtn}"
                            Padding="22,10" Margin="0,22,0,0" HorizontalAlignment="Center" Click="AddProfile_Click"/>
                    <TextBlock Foreground="{StaticResource FaintBrush}" FontSize="12" TextAlignment="Center"
                               TextWrapping="Wrap" Margin="0,30,0,0" LineHeight="20"
                               Text="Ctrl+K switch profile    Ctrl+B hide panel    Ctrl+T new tab    Ctrl+H history"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
