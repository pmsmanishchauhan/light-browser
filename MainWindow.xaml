<Window x:Class="LightBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LightBrowser" Width="1280" Height="800" MinWidth="760" MinHeight="480"
        Background="#1E1F24" FontFamily="Segoe UI Variable Text, Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Profiles -->
        <DockPanel Grid.Column="0" Background="#25262B">
            <Grid DockPanel.Dock="Top" Margin="16,14,8,6">
                <TextBlock Text="PROFILES" Foreground="#8A8D96" FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Content="&#xE710;" Style="{StaticResource IconBtn}" HorizontalAlignment="Right"
                        ToolTip="New profile" AutomationProperties.Name="New profile" Click="AddProfile_Click"/>
            </Grid>
            <Border DockPanel.Dock="Top" Margin="10,0,10,8" Background="#1E1F24" BorderBrush="#3A3B42"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons" FontSize="12"
                               Foreground="#6B6E78" Margin="10,0,0,0" VerticalAlignment="Center"
                               HorizontalAlignment="Left" IsHitTestVisible="False"/>
                    <TextBox x:Name="SearchBox" Padding="30,7,8,7" Background="Transparent" BorderThickness="0"
                             Foreground="#E6E6E6" CaretBrush="#E6E6E6" SelectionBrush="#4F8EF7"
                             TextChanged="Search_TextChanged" KeyDown="SearchBox_KeyDown"/>
                    <TextBlock x:Name="SearchHint" Text="Search profiles (Ctrl+K)" Foreground="#6B6E78"
                               Margin="31,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
            </Border>
            <TextBlock x:Name="StatsText" DockPanel.Dock="Bottom" Foreground="#6B6E78" FontSize="10.5"
                       TextWrapping="Wrap" Margin="16,0,10,10"
                       ToolTip="Tabs loaded now / limit for the current mode, and this app's memory including its browser processes"/>
            <Grid DockPanel.Dock="Bottom" Margin="10,0,10,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ModeLowBtn" Grid.Column="0" Content="Low RAM" Tag="LowMemory" FontSize="11"
                        Style="{StaticResource Flat}" Click="Mode_Click"
                        ToolTip="Low RAM: 2 tabs loaded at once, unused tabs unloaded after 3 minutes. Best for many clients on a small PC."/>
                <Button x:Name="ModeBalancedBtn" Grid.Column="1" Content="Balanced" Tag="Balanced" FontSize="11"
                        Style="{StaticResource Flat}" Click="Mode_Click"
                        ToolTip="Balanced: 5 tabs loaded at once, unused tabs unloaded after 10 minutes."/>
                <Button x:Name="ModePerformanceBtn" Grid.Column="2" Content="Fast" Tag="Performance" FontSize="11"
                        Style="{StaticResource Flat}" Click="Mode_Click"
                        ToolTip="Fast: 15 tabs loaded at once, unused tabs kept for an hour, hidden tabs not trimmed. Fastest switching, uses the most RAM."/>
            </Grid>
            <Button x:Name="TrashBtn" DockPanel.Dock="Bottom" Content="Trash" Style="{StaticResource Flat}"
                    Foreground="#8A8D96" Margin="10,0,10,4" Click="Trash_Click"/>
            <Button DockPanel.Dock="Bottom" Content="Launch site in profiles..." Style="{StaticResource Flat}"
                    Margin="10,8,10,0" Click="Launch_Click"
                    ToolTip="Open one website in several profiles at once, or close several profiles"/>
            <Button DockPanel.Dock="Bottom" Content="+ New profile" Style="{StaticResource Flat}"
                    Background="#4F8EF7" Foreground="White" FontWeight="SemiBold" Margin="10,8,10,4" Padding="8,9"
                    Click="AddProfile_Click"/>
            <ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource Item}"
                     VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ProfileList_SelectionChanged">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Foreground="#8A8D96" FontSize="11"
                                           FontWeight="SemiBold" Margin="14,12,0,3"/>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Background="Transparent" ToolTip="{Binding Tip}"
                              MouseLeftButtonDown="ProfileRow_MouseDown">
                            <Grid.ContextMenu>
                                <ContextMenu Opened="ProfileMenu_Opened">
                                    <MenuItem Tag="normal" Header="Open home pages" Click="OpenHome_Click"/>
                                    <MenuItem Tag="normal" Header="Rename (F2)" Click="Rename_Click"/>
                                    <MenuItem Tag="normal" Header="Edit..." Click="EditProfile_Click"/>
                                    <MenuItem Tag="normal" Header="History..." Click="History_Click"/>
                                    <MenuItem Tag="normal" Header="Saved passwords..." Click="Passwords_Click"/>
                                    <MenuItem Tag="normal" Header="Duplicate (without logins)" Click="Duplicate_Click"/>
                                    <MenuItem Tag="open" Header="Close profile (frees memory)" Click="CloseProfile_Click"/>
                                    <MenuItem Tag="open" Header="Restart profile" Click="Restart_Click"/>
                                    <MenuItem Tag="normal" Header="Clear website data..." Click="ClearData_Click"/>
                                    <MenuItem Tag="normal" Header="Move to Trash" Click="MoveToTrash_Click"/>
                                    <MenuItem Tag="trash" Header="Restore" Click="Restore_Click"/>
                                    <MenuItem Tag="trash" Header="Delete forever (wipes its data)" Click="DeleteForever_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="26" Height="26" Margin="0,0,9,0">
                                <Ellipse Fill="{Binding Brush}"/>
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold"
                                           FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Ellipse Grid.Column="2" Width="7" Height="7" Fill="#3DBE7A" Margin="6,0,6,0" ToolTip="Open"
                                     Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}"/>
                            <StackPanel x:Name="HoverButtons" Grid.Column="3" Orientation="Horizontal" Visibility="Collapsed">
                                <Button x:Name="RenameBtn" Content="&#xE70F;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Rename" AutomationProperties.Name="Rename" Click="Rename_Click"/>
                                <Button x:Name="TrashItemBtn" Content="&#xE74D;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Move to Trash" AutomationProperties.Name="Move to Trash" Click="MoveToTrash_Click"/>
                                <Button x:Name="RestoreBtn" Content="&#xE7A7;" Style="{StaticResource IconBtn}"
                                        Width="26" Height="26" FontSize="11" ToolTip="Restore" AutomationProperties.Name="Restore" Visibility="Collapsed"
                                        Click="Restore_Click"/>
                            </StackPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="HoverButtons" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                <Setter TargetName="RenameBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="TrashItemBtn" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="RestoreBtn" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Colour bar, tabs, toolbar, page -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="3"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="46"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Shows which client profile you are in, in that profile's colour -->
            <Border x:Name="ProfileBar" Grid.Row="0" Background="Transparent"/>

            <DockPanel Grid.Row="1" Background="#2B2C32">
                <Button DockPanel.Dock="Right" Content="&#xE710;" Style="{StaticResource IconBtn}"
                        Margin="4,5,6,5" ToolTip="New tab (Ctrl+T)" AutomationProperties.Name="New tab" Click="NewTab_Click"/>
                <ListBox x:Name="TabList" Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource TabItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         SelectionChanged="TabList_SelectionChanged"
                         PreviewMouseDown="TabList_PreviewMouseDown"
                         PreviewMouseWheel="TabList_PreviewMouseWheel">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" ToolTip="{Binding Title}" Background="Transparent">
                                <TextBlock Text="{Binding Title}" MaxWidth="170" Margin="0,0,4,0"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Content="&#xE711;" Style="{StaticResource IconBtn}" Width="22" Height="22"
                                        FontSize="9" ToolTip="Close tab (Ctrl+W)" AutomationProperties.Name="Close tab" Click="CloseTab_Click"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <Grid Grid.Row="2" Background="#25262B">
                <DockPanel Margin="6,0,6,0">
                    <Button x:Name="BackBtn" DockPanel.Dock="Left" Content="&#xE72B;" Style="{StaticResource IconBtn}"
                            Margin="0,0,2,0" ToolTip="Back" AutomationProperties.Name="Back" Click="Back_Click"/>
                    <Button x:Name="ForwardBtn" DockPanel.Dock="Left" Content="&#xE72A;" Style="{StaticResource IconBtn}"
                            Margin="0,0,2,0" ToolTip="Forward" AutomationProperties.Name="Forward" Click="Forward_Click"/>
                    <Button DockPanel.Dock="Left" Content="&#xE72C;" Style="{StaticResource IconBtn}"
                            Margin="0,0,8,0" ToolTip="Reload" AutomationProperties.Name="Reload" Click="Reload_Click"/>
                    <Button DockPanel.Dock="Right" Content="&#xE81C;" Style="{StaticResource IconBtn}"
                            Margin="4,0,0,0" ToolTip="History (Ctrl+H)" AutomationProperties.Name="History" Click="HistoryButton_Click"/>
                    <Button DockPanel.Dock="Right" Content="Passwords" Style="{StaticResource Flat}" FontSize="12"
                            Margin="4,0,0,0" Height="30" ToolTip="This profile's saved passwords"
                            Click="PasswordsButton_Click"/>
                    <Border Background="#1E1F24" BorderBrush="#3A3B42" BorderThickness="1" CornerRadius="16"
                            Height="32">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SecurityIcon" Grid.Column="0" FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                       FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="#6B6E78" Text="&#xE721;" IsHitTestVisible="True"/>
                            <TextBox x:Name="Address" Grid.Column="1" Padding="0,0,12,0" VerticalContentAlignment="Center"
                                     Background="Transparent" BorderThickness="0" Foreground="#E6E6E6"
                                     CaretBrush="#E6E6E6" SelectionBrush="#4F8EF7" KeyDown="Address_KeyDown"
                                     PreviewKeyDown="Address_PreviewKeyDown" TextChanged="Address_TextChanged"
                                     LostKeyboardFocus="Address_LostFocus"/>
                        </Grid>
                    </Border>
                </DockPanel>
                <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=Address}"
                       Placement="Bottom" StaysOpen="True" AllowsTransparency="True">
                    <Border Background="#2B2C32" BorderBrush="#3A3B42" BorderThickness="1" CornerRadius="8"
                            Padding="2" MinWidth="{Binding ActualWidth, ElementName=Address}">
                        <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0"
                                 ItemContainerStyle="{StaticResource Item}"
                                 PreviewMouseLeftButtonDown="SuggestList_PreviewMouseLeftButtonDown"/>
                    </Border>
                </Popup>
                <ProgressBar x:Name="Loading" IsIndeterminate="True" Height="2" VerticalAlignment="Bottom"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="Collapsed"/>
            </Grid>

            <Grid Grid.Row="3">
                <Grid x:Name="WebHost"/>
                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="EmptyState" Text="Create a profile on the left to begin"
                               Foreground="#8A8D96" FontSize="16" TextAlignment="Center"
                               IsHitTestVisible="False"/>
                    <Button x:Name="EmptyNewBtn" Content="+ New profile" Style="{StaticResource Flat}"
                            Background="#4F8EF7" Foreground="White" FontWeight="SemiBold" Padding="18,9"
                            Margin="0,16,0,0" HorizontalAlignment="Center" Click="AddProfile_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
